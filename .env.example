# KaSaa Experiences — Environment Configuration Example
# Copy this file to .env or .env.local to customize local or deployment values.

# Production domain (used for canonical links, sitemaps, and share tags)
VITE_SITE_URL=https://kasaaexperiences.com

# Official WhatsApp phone number (international format digits only, e.g., 919876543210)
# Leave blank until supplied by business owner; fallback copy flow activates automatically.
VITE_WHATSAPP_NUMBER=

# Official calling phone number (optional)
VITE_PHONE_NUMBER=

# Official Google Maps Place URL (optional, defaults to search query)
VITE_MAP_URL=
